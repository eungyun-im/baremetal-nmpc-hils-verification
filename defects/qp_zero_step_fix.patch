+  /* 같은 판정: 반올림 크기로 미는 변수는 함께 고정하지 않는다 (x + d 가 실제로 넘을 때만). a 는 상한, d_a 는 약 1e-20, b 는 진짜 바깥 */
+  prob_begin(p, 3);
